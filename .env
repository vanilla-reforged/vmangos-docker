MYSQL_ROOT_PASSWORD=mangos

TZ=Europe/Amsterdam

VMANGOS_CLIENT=5875
VMANGOS_USER_ID=1000
VMANGOS_GROUP_ID=1000

# Initial Docker resource limits
# setup-05-docker-resources-initialize.sh will update these values.
MEM_RESERVATION_DB=1g
MEM_RESERVATION_MANGOS=1.5g
MEM_RESERVATION_REALMD=0.1g

MEM_LIMIT_DB=1g
MEM_LIMIT_MANGOS=1.5g
MEM_LIMIT_REALMD=0.1g

MEMSWAP_LIMIT_DB=2g
MEMSWAP_LIMIT_MANGOS=3g
MEMSWAP_LIMIT_REALMD=0.2g

CPU_SHARES_DB=1024
CPU_SHARES_MANGOS=1024
CPU_SHARES_REALMD=1024

# VMaNGOS API
VMANGOS_API_KEY=your_super_secret_key_here

# SOAP account used by the API
VMANGOS_API_REG_USER=admin
VMANGOS_API_REG_PASS=adminpassword

# Database credentials used by the API
VMANGOS_API_DB_HOST=vmangos-database
VMANGOS_API_DB_USER=mangos
VMANGOS_API_DB_PASS=mangos
VMANGOS_API_DB_NAME=realmd
